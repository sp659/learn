<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        LOGBACK CONFIGURATION
        =====================
        Carina uses SLF4J + Logback for all internal and test logging.
        This config controls:
          - What log level is captured
          - Where logs go (console and/or file)
          - How log messages are formatted
    -->

    <!-- Console Appender: prints logs to your terminal/IDE -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!--
                Pattern breakdown:
                %d{HH:mm:ss.SSS}  → Timestamp
                [%thread]          → Thread name (important for parallel tests)
                %-5level           → Log level padded to 5 chars (INFO , WARN , ERROR)
                %logger{36}        → Logger class name (max 36 chars)
                %msg%n             → The actual log message
            -->
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File Appender: writes logs to a rolling file in target/logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>target/logs/carina-test.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Roll over daily and keep 7 days of logs -->
            <fileNamePattern>target/logs/carina-test.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress noisy Selenium/WebDriver internal logs -->
    <logger name="org.openqa.selenium" level="WARN"/>
    <logger name="io.github.bonigarcia" level="WARN"/>
    <logger name="org.apache.http" level="WARN"/>

    <!-- Carina framework logs at INFO level -->
    <logger name="com.zebrunner" level="INFO"/>

    <!-- Our test code logs at DEBUG level for detailed output -->
    <logger name="com.carina.demo" level="DEBUG"/>

    <!-- Root logger: everything else at INFO -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
